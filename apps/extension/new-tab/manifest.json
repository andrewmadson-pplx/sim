{
  "manifest_version": 3,
  "name": "Sim New Tab",
  "version": "1.0.1",
  "description": "Use Sim as your new tab. Start a conversation on your Sim Home and restore your previous new tab at any time.",
  "minimum_chrome_version": "120",
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "host_permissions": ["https://www.sim.ai/*"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; frame-src https://www.sim.ai; object-src 'none'; base-uri 'none'"
  },
  "incognito": "not_allowed",
  "key": ""
}
